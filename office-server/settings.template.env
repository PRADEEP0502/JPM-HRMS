# JPM HRMS - server settings. Keep this file private (never copy it into git or share it).
# After install-admin.ps1 runs, only Administrators and SYSTEM can open it:
# to edit later, open Notepad with "Run as administrator", then run restart.ps1.

# MongoDB Atlas address, e.g. mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
MONGO_URI=

# Login for the app's "Sign in" box. The app is on the internet, so use a strong password
# (at least 10 characters, e.g. 3 random words + numbers). Share it only with HR.
APP_USERNAME=
APP_PASSWORD=

# Secret shared with the WhatsApp bot: a long random text (20+ characters).
# Put the SAME text as "botToken" in C:\JPM-HRMS-PY\whatsapp-bot\config.json
WA_BOT_TOKEN=

# Port and network address. Normally leave as is.
PORT=8081
HOST=0.0.0.0
